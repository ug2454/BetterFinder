  "runner": "\nawait Promise.all(['Regular','Medium','Semibold','Bold'].map(style=>figma.loadFontAsync({family:'SF Pro',style})));\nconst map=MAP;const out={};const ids=[];const col=h=>({r:parseInt(h.slice(1,3),16)/255,g:parseInt(h.slice(3,5),16)/255,b:parseInt(h.slice(5,7),16)/255});\nfor(const d of DATA){\nlet n=d.type==='text'?figma.createText():d.type==='svg'?figma.createNodeFromSvg(d.svg):d.type==='ellipse'?figma.createEllipse():figma.createAutoLayout(d.dir||'HORIZONTAL');\nn.name=d.name;const p=await figma.getNodeByIdAsync(map[d.parent]||out[d.parent]);p.appendChild(n);\nif(d.type==='text'){n.fontName={family:'SF Pro',style:d.weight||'Regular'};n.fontSize=d.size||13;n.characters=d.text;n.textAutoResize='NONE';n.resize(d.w,d.h||20);n.lineHeight={unit:'PIXELS',value:d.lh||20};}\nelse if(d.type!=='svg'){n.resize(d.w,d.h);if(d.type!=='ellipse'){n.itemSpacing=d.gap||0;n.paddingLeft=d.pad||0;n.paddingRight=d.pad||0;n.paddingTop=d.padY||0;n.paddingBottom=d.padY||0;n.counterAxisAlignItems=d.align||'CENTER';n.primaryAxisAlignItems=d.justify||'MIN';n.clipsContent=true;n.cornerRadius=d.radius||0;}}\nif(d.color)n.fills=[{type:'SOLID',color:col(d.color)}];else if(d.type!=='svg')n.fills=[];\nif(d.stroke){n.strokes=[{type:'SOLID',color:col(d.stroke)}];n.strokeWeight=1;}\nif(d.x!==undefined){n.x=d.x;n.y=d.y;}\nif(d.grow)n.layoutGrow=1;\nout[d.name]=n.id;ids.push(n.id);if(d.type==='svg')ids.push(...n.findAll(()=>true).map(c=>c.id));\n}\nreturn {map:out,createdNodeIds:ids};\n"
}
